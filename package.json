{
  "name": "playwright-magang",
  "version": "1.0.0",
  "description": "Industrial Standard Playwright E2E Automation for Hadir Magang",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
